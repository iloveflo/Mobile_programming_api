# ==============================================================================
# FINCREDIT BACKEND (EXPRESS.JS) - ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
API_PREFIX=/api/v1
CORS_ORIGIN=*

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Kết nối PostgreSQL Database (16 bảng trong credit_health_db.sql)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=credit_health_db
DB_MAX_CLIENTS=20
DB_TIMEZONE=+07:00

# JWT Auth
JWT_SECRET=your_jwt_access_secret_key_min_64_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_min_64_chars
JWT_REFRESH_EXPIRES_IN=7d

# OTP Config
OTP_LENGTH=6
OTP_EXPIRES_IN_SECONDS=120
OTP_MAX_ATTEMPTS=5

# Cloudflare R2 Storage (AWS S3-compatible API)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_ENDPOINT=https://<your_account_id>.r2.cloudflarestorage.com
R2_PRESIGNED_UPLOAD_EXPIRES=300
R2_PRESIGNED_VIEW_EXPIRES=600

# Public Bucket (Avatar, ảnh tài sản công khai)
R2_BUCKET_PUBLIC=fincredit-public
R2_PUBLIC_DOMAIN=https://pub-<id>.r2.dev

# Private Bucket (Hợp đồng, CCCD, Bảng lương, Sổ đỏ)
R2_BUCKET_PRIVATE=fincredit-private

# Mail SMTP (Tùy chọn)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="FinCredit Support" <no-reply@fincredit.vn>

